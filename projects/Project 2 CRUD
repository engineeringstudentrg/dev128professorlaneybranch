  """
PEOPLE_GUI.PY - Presentation Layer
==================================
This file handles ALL GUI operations using Tkinter.
It imports database_operations.py to access business logic.
"""

import sys
import os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import tkinter as tk
from tkinter import messagebox
import database_operations as database


FONT_TITLE = ('Arial', 16, 'bold')
FONT_LABEL = ('Arial', 12, 'bold')
FONT_INPUT = ('Arial', 12)
FONT_LIST = ('Arial', 12)
FONT_BUTTON = ('Arial', 11, 'bold')
FONT_DETAILS = ('Arial', 12)


class CRUDApplication:
    def __init__(self, root):
        self.root = root
        self.root.title("People Directory - CRUD Application")
        self.root.geometry("760x620")
        
        database.create_database()
        
        self.create_menu()
        self.create_main_layout()
        self.refresh_list()
    
    def create_menu(self):
        menubar = tk.Menu(self.root)
        self.root.config(menu=menubar)
        
        crud_menu = tk.Menu(menubar, tearoff=0, font=FONT_INPUT)
        menubar.add_cascade(label="Actions", menu=crud_menu)
        
        crud_menu.add_command(label="Add Person", command=self.add_person)
        crud_menu.add_command(label="Read Person", command=self.read_person)
        crud_menu.add_command(label="Edit Person", command=self.edit_person)
        crud_menu.add_command(label="Delete Person", command=self.delete_person)
        crud_menu.add_separator()
        crud_menu.add_command(label="Refresh List", command=self.refresh_list)
        crud_menu.add_separator()
        crud_menu.add_command(label="Exit", command=self.root.quit)
    
    def create_main_layout(self):
        main_frame = tk.Frame(self.root)
        main_frame.pack(fill=tk.BOTH, expand=True, padx=15, pady=15)
        
        tk.Label(main_frame, text="People Directory", 
                 font=FONT_TITLE).pack(pady=(0, 10))
        
        listbox_frame = tk.Frame(main_frame)
        listbox_frame.pack(fill=tk.BOTH, expand=True)
        
        scrollbar = tk.Scrollbar(listbox_frame)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        self.listbox = tk.Listbox(listbox_frame, 
                                  yscrollcommand=scrollbar.set, 
                                  font=FONT_LIST,
                                  activestyle='dotbox',
                                  selectbackground='#2b5b84',
                                  selectforeground='white')
        self.listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        scrollbar.config(command=self.listbox.yview)
        
        button_frame = tk.Frame(main_frame)
        button_frame.pack(pady=15)
        
        tk.Button(button_frame, text="Add", font=FONT_BUTTON,
                  command=self.add_person, width=12).grid(row=0, column=0, padx=6)
        tk.Button(button_frame, text="Read", font=FONT_BUTTON,
                  command=self.read_person, width=12).grid(row=0, column=1, padx=6)
        tk.Button(button_frame, text="Edit", font=FONT_BUTTON,
                  command=self.edit_person, width=12).grid(row=0, column=2, padx=6)
        tk.Button(button_frame, text="Delete", font=FONT_BUTTON,
                  command=self.delete_person, width=12).grid(row=0, column=3, padx=6)
    
    def add_person(self):
        add_window = tk.Toplevel(self.root)
        add_window.title("Add Person")
        add_window.geometry("520x560")
        
        form_frame = tk.Frame(add_window, padx=20, pady=15)
        form_frame.pack(fill=tk.BOTH, expand=True)
        
        tk.Label(form_frame, text="* Indicates required field",
                 font=('Arial', 10, 'italic'), fg='#555555').grid(
            row=0, column=0, columnspan=2, sticky='w', pady=(0, 10))
        
        fields = [
            ("First Name *:", 1),
            ("Last Name *:", 2),
            ("Email *:", 3),
            ("Job Title *:", 4),
            ("Street Address *:", 5),
            ("City *:", 6),
            ("State *:", 7),
            ("Zipcode *:", 8),
        ]
        
        entries = {}
        for label_text, row_idx in fields:
            tk.Label(form_frame, text=label_text, font=FONT_LABEL).grid(
                row=row_idx, column=0, sticky='e', padx=8, pady=6)
            entry = tk.Entry(form_frame, width=30, font=FONT_INPUT)
            entry.grid(row=row_idx, column=1, sticky='w', padx=8, pady=6)
            entries[label_text] = entry
        
        entries["First Name *:"].focus()
        
        tk.Label(form_frame, text="Notes (Optional):", font=FONT_LABEL).grid(
            row=9, column=0, sticky='ne', padx=8, pady=6)
        notes_text = tk.Text(form_frame, width=30, height=4, font=FONT_INPUT)
        notes_text.grid(row=9, column=1, sticky='w', padx=8, pady=6)
        
        def save_person():
            first = entries["First Name *:"].get().strip()
            last = entries["Last Name *:"].get().strip()
            email = entries["Email *:"].get().strip()
            job_title = entries["Job Title *:"].get().strip()
            street = entries["Street Address *:"].get().strip()
            city = entries["City *:"].get().strip()
            state = entries["State *:"].get().strip()
            zipcode = entries["Zipcode *:"].get().strip()
            notes = notes_text.get("1.0", tk.END).strip()
            
            is_valid, error_message = database.validate_person_data(
                first, last, email, street, city, state, zipcode, job_title
            )
            
            if not is_valid:
                messagebox.showerror("Validation Error", error_message, parent=add_window)
                return
            
            person_id = database.add_person(
                first, last, email, street, city, state, zipcode, job_title, notes
            )
            
            messagebox.showinfo("Success", 
                                f"Person added successfully!\nID: {person_id}",
                                parent=add_window)
            
            add_window.destroy()
            self.refresh_list()
        
        btn_frame = tk.Frame(form_frame)
        btn_frame.grid(row=10, column=0, columnspan=2, pady=15)
        
        tk.Button(btn_frame, text="Save", font=FONT_BUTTON,
                  command=save_person, width=12).pack(side=tk.LEFT, padx=10)
        tk.Button(btn_frame, text="Cancel", font=FONT_BUTTON,
                  command=add_window.destroy, width=12).pack(side=tk.LEFT, padx=10)
    
    def read_person(self):
        selection = self.listbox.curselection()
        if not selection:
            messagebox.showwarning("No Selection", 
                                   "Please select a person from the list!")
            return
        
        person_info = self.listbox.get(selection[0])
        person_id = int(person_info.split(" - ")[0])
        
        person = database.get_person_by_id(person_id)
        if not person:
            messagebox.showerror("Error", "Person not found in database!")
            return
        
        pid, first, last, email, street, city, state, zipcode, job_title, notes = person
        
        read_window = tk.Toplevel(self.root)
        read_window.title(f"Person Details - {first} {last}")
        read_window.geometry("480x440")
        
        container = tk.Frame(read_window, padx=25, pady=20)
        container.pack(fill=tk.BOTH, expand=True)
        
        tk.Label(container, text=f"{first} {last}", font=FONT_TITLE).pack(anchor='w', pady=(0, 10))
        
        details = (
            f"ID: {pid}\n"
            f"Job Title: {job_title}\n"
            f"Email: {email}\n\n"
            f"Address:\n"
            f"  {street}\n"
            f"  {city}, {state} {zipcode}\n\n"
            f"Notes:\n"
            f"  {notes if notes else '(no notes)'}"
        )
        
        tk.Label(container, text=details, justify='left',
                 font=FONT_DETAILS, wraplength=420).pack(anchor='w', pady=5)
        
        tk.Button(container, text="Close", font=FONT_BUTTON,
                  command=read_window.destroy, width=12).pack(pady=20)
    
    def edit_person(self):
        selection = self.listbox.curselection()
        if not selection:
            messagebox.showwarning("No Selection", 
                                   "Please select a person to edit!")
            return
        
        person_info = self.listbox.get(selection[0])
        person_id = int(person_info.split(" - ")[0])
        
        person = database.get_person_by_id(person_id)
        if not person:
            messagebox.showerror("Error", "Person not found in database!")
            return
        
        pid, first, last, email, street, city, state, zipcode, job_title, notes = person
        
        edit_window = tk.Toplevel(self.root)
        edit_window.title(f"Edit Person - {first} {last}")
        edit_window.geometry("520x560")
        
        form_frame = tk.Frame(edit_window, padx=20, pady=15)
        form_frame.pack(fill=tk.BOTH, expand=True)
        
        tk.Label(form_frame, text="* Indicates required field",
                 font=('Arial', 10, 'italic'), fg='#555555').grid(
            row=0, column=0, columnspan=2, sticky='w', pady=(0, 10))
        
        fields = [
            ("First Name *:", first, 1),
            ("Last Name *:", last, 2),
            ("Email *:", email, 3),
            ("Job Title *:", job_title, 4),
            ("Street Address *:", street, 5),
            ("City *:", city, 6),
            ("State *:", state, 7),
            ("Zipcode *:", zipcode, 8),
        ]
        
        entries = {}
        for label_text, initial_val, row_idx in fields:
            tk.Label(form_frame, text=label_text, font=FONT_LABEL).grid(
                row=row_idx, column=0, sticky='e', padx=8, pady=6)
            entry = tk.Entry(form_frame, width=30, font=FONT_INPUT)
            def edit_person(self):
                selection = self.listbox.curselection()
                if not selection:
                    messagebox.showwarning("No Selection", 
                                           "Please select a person to edit!")
                    return
                
                person_info = self.listbox.get(selection[0])
                person_id = int(person_info.split(" - ")[0])
                
                person = database.get_person_by_id(person_id)
                if not person:
                    messagebox.showerror("Error", "Person not found in database!")
                    return
                
                pid, first, last, email, street, city, state, zipcode, job_title, notes = person
                
                edit_window = tk.Toplevel(self.root)
                edit_window.title(f"Edit Person - {first} {last}")
                edit_window.geometry("520x560")
                
                form_frame = tk.Frame(edit_window, padx=20, pady=15)
                form_frame.pack(fill=tk.BOTH, expand=True)
                
                tk.Label(form_frame, text="* Indicates required field",
                         font=('Arial', 10, 'italic'), fg='#555555').grid(
                    row=0, column=0, columnspan=2, sticky='w', pady=(0, 10))
                
                fields = [
                    ("First Name *:", first, 1),
                    ("Last Name *:", last, 2),
                    ("Email *:", email, 3),
                    ("Job Title *:", job_title, 4),
                    ("Street Address *:", street, 5),
                    ("City *:", city, 6),
                    ("State *:", state, 7),
                    ("Zipcode *:", zipcode, 8),
                ]
                
                entries = {}
                for label_text, initial_val, row_idx in fields:
                    tk.Label(form_frame, text=label_text, font=FONT_LABEL).grid(
                        row=row_idx, column=0, sticky='e', padx=8, pady=6)
                    entry = tk.Entry(form_frame, width=30, font=FONT_INPUT)
                    entry.insert(0, initial_val if initial_val else "")
                    entry.grid(row=row_idx, column=1, sticky='w', padx=8, pady=6)
                    entries[label_text] = entry
                
                tk.Label(form_frame, text="Notes (Optional):", font=FONT_LABEL).grid(
                    row=9, column=0, sticky='ne', padx=8, pady=6)
                notes_text = tk.Text(form_frame, width=30, height=4, font=FONT_INPUT)
                notes_text.insert("1.0", notes if notes else "")
                notes_text.grid(row=9, column=1, sticky='w', padx=8, pady=6)
                
                def update_person():
                    new_first = entries["First Name *:"].get().strip()
                    new_last = entries["Last Name *:"].get().strip()
                    new_email = entries["Email *:"].get().strip()
                    new_job_title = entries["Job Title *:"].get().strip()
                    new_street = entries["Street Address *:"].get().strip()
                    new_city = entries["City *:"].get().strip()
                    new_state = entries["State *:"].get().strip()
                    new_zipcode = entries["Zipcode *:"].get().strip()
                    new_notes = notes_text.get("1.0", tk.END).strip()
                    
                    is_valid, error_message = database.validate_person_data(
                        new_first, new_last, new_email, new_street,
                        new_city, new_state, new_zipcode, new_job_title
                    )
                    
                    if not is_valid:
                        messagebox.showerror("Validation Error", error_message, parent=edit_window)
                        return
                    
                    success = database.update_person(
                        person_id, new_first, new_last, new_email, new_street,
                        new_city, new_state, new_zipcode, new_job_title, new_notes
                    )
                    
                    if success:
                        messagebox.showinfo("Success", "Person updated successfully!", parent=edit_window)
                        edit_window.destroy()
                        self.refresh_list()
                    else:
                        messagebox.showerror("Error", "Failed to update person!", parent=edit_window)
                
                btn_frame = tk.Frame(form_frame)
                btn_frame.grid(row=10, column=0, columnspan=2, pady=15)
                
                tk.Button(btn_frame, text="Update", font=FONT_BUTTON,
                          command=update_person, width=12).pack(side=tk.LEFT, padx=10)
                tk.Button(btn_frame, text="Cancel", font=FONT_BUTTON,
                          command=edit_window.destroy, width=12).pack(side=tk.LEFT, padx=10)
            
            def delete_person(self):
                selection = self.listbox.curselection()
                if not selection:
                    messagebox.showwarning("No Selection", 
                                           "Please select a person to delete!")
                    return
                
                person_info = self.listbox.get(selection[0])
                person_id = int(person_info.split(" - ")[0])
                
                confirm = messagebox.askyesno(
                    "Confirm Delete", 
                    f"Are you sure you want to delete:\n\n{person_info}\n\nThis cannot be undone!"
                )
                
                if not confirm:
                    return
                
                success = database.delete_person(person_id)
                
                if success:
                    messagebox.showinfo("Success", "Person deleted successfully!")
                    self.refresh_list()
                else:
                    messagebox.showerror("Error", "Failed to delete person!")
            
            def refresh_list(self):
                self.listbox.delete(0, tk.END)
                
                people = database.get_all_people()
                
                for person in people:
                    person_id, first, last, job_title, email = person
                    display_text = f"{person_id} - {first} {last} | {job_title} ({email})"
                    self.listbox.insert(tk.END, display_text)
        if __name__ == "__main__":
            root = tk.Tk()
            app = CRUDApplication(root)
            root.mainloop()
